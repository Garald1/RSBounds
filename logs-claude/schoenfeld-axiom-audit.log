def TernaryGoldbach.RSBounds.Goals.Schoenfeld1976.PsiLogLower : Prop :=
Goals.FiniteRH 1894439 → ∀ (x : ℝ), 89909 ≤ x → -(220646e-7 * x / Real.log x) < Chebyshev.psi x - x
def TernaryGoldbach.RSBounds.Goals.Schoenfeld1976.ThetaLogUpper : Prop :=
