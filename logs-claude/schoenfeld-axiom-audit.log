def TernaryGoldbach.RSBounds.Goals.Schoenfeld1976.PsiTheorem11 : Prop :=
Goals.FiniteRH 1894439 → ∀ (x : ℝ), 17 ≤ x → |Chebyshev.psi x - x| < x * Goals.Schoenfeld1976.epsilon0 x
