def TernaryGoldbach.RSBounds.Goals.Schoenfeld1976.PsiCert : Prop :=
∀ (x : ℝ), 1500 ≤ x → x ≤ 10 ^ 10 → |Chebyshev.psi x - x| ≤ 4 / 5 * √x
def TernaryGoldbach.RSBounds.Goals.Schoenfeld1976.PsiThetaLog : Prop :=
Goals.FiniteRH 1894439 →
  ∀ (x : ℝ),
    Real.exp 22 ≤ x →
      |Chebyshev.psi x - x| < 77629e-7 * x / Real.log x ∧ |Chebyshev.theta x - x| < 77629e-7 * x / Real.log x
def TernaryGoldbach.RSBounds.Goals.Schoenfeld1976.ThetaLog : Prop :=
Goals.FiniteRH 1894439 → ∀ (x : ℝ), 758711 ≤ x → |Chebyshev.theta x - x| < 239922e-7 * x / Real.log x
def TernaryGoldbach.RSBounds.Goals.Schoenfeld1976.PsiLog : Prop :=
