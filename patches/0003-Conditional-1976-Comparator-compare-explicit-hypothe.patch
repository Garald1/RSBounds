-      ∃! s : ℂ, riemannZeta s = 0 ∧ |s.im - (m : ℝ) / 10 ^ 24| ≤ 1 / 10 ^ 20) ∧
-    (Zeros0to1000.zerosBetween 0 1000).ncard = 649
-
-end TernaryGoldbach.RSBounds.Head1000
-
 namespace TernaryGoldbach.RSBounds.PsiTable1976
 
-theorem psi_error_lt (h : Head1000.Certified) (hRH : Goals.FiniteRH 1894438.5122) {x : ℝ}
-    (hx : Real.exp 23 ≤ x) : |Chebyshev.psi x - x| < 0.00020171 * x := by sorry
-
-theorem of_certified (h : Head1000.Certified) : Goals.PsiTable1976 := by sorry
+theorem psi_error_of_zeros0to1000
