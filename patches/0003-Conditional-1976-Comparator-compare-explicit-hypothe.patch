-`Head1000.Certified` is the conjunction of those three theorem statements.
-The result is conditional on it. -/
+The two theorems take those three statements as hypotheses, in their exact
+form; the results are conditional on them.
+
+`Goals.PsiTable1975` is not compared. It is included because the solution's
+`Goals.PsiTable1976` (in `RSBounds/Targets.lean`) shares the auxiliary proof
+constant `PsiTable1975._proof_1` for the literal `23 : ℝ`; defining it first
+gives the challenge's `PsiTable1976` the same term. -/
 
 namespace Zeros0to1000
 
@@ -146,28 +151,35 @@ def FiniteRH (A : ℝ) : Prop :=
   ∀ ρ : ℂ, riemannZeta ρ = 0 → 0 < ρ.re → ρ.re < 1 →
     |ρ.im| ≤ A → ρ.re = 1 / 2
 
+def PsiTable1975 : Prop :=
+  FiniteRH 1894438.5122 → ∀ x : ℝ, Real.exp 23 ≤ x →
+    |Chebyshev.psi x - x| < 0.00020211 * x
+
 def PsiTable1976 : Prop :=
   FiniteRH 1894438.5122 → ∀ x : ℝ, Real.exp 23 ≤ x →
     |Chebyshev.psi x - x| < 0.00020171 * x
 
 end TernaryGoldbach.RSBounds.Goals
 
